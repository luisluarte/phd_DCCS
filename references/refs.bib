@article{suvrathanTimingRulesSynaptic2016,
  title = {Timing {{Rules}} for {{Synaptic Plasticity Matched}} to {{Behavioral Function}}},
  author = {Suvrathan, Aparna and Payne, Hannah L. and Raymond, Jennifer L.},
  date = {2016-12-07},
  journaltitle = {Neuron},
  volume = {92},
  number = {5},
  eprint = {27839999},
  eprinttype = {pubmed},
  pages = {959--967},
  issn = {1097-4199},
  doi = {10.1016/j.neuron.2016.10.022},
  abstract = {It is widely assumed that the complexity of neural circuits enables them to implement diverse learning tasks using just a few generic forms of synaptic plasticity. In contrast, we report that synaptic plasticity can itself be precisely tuned to the requirements of a learning task. We found that the rules for induction of long-term and single-trial plasticity at parallel fiber-to-Purkinje cell synapses vary across cerebellar regions. In the flocculus, associative plasticity in~vitro and in~vivo is narrowly tuned for an interval of ∼120~ms, which compensates for the specific processing delay for error signals to reach the flocculus during oculomotor learning. In the vermis, which supports a range of behavioral functions, plasticity is induced by a range of intervals, with individual cells tuned for different intervals. Thus, plasticity at a single, anatomically defined type of synapse can have properties that vary in a way that is precisely matched to function.},
  langid = {english},
  pmcid = {PMC5165237},
  keywords = {Animals,Cerebellar Vermis,Cerebellum,Eye Movements,Formative Feedback,In Vitro Techniques,Learning,Long-Term Synaptic Depression,Male,Mice,Neuronal Plasticity,Purkinje Cells,Time Factors},
  file = {/home/nicoluarte/Zotero/storage/BVZ22EGY/Suvrathan et al. - 2016 - Timing Rules for Synaptic Plasticity Matched to Behavioral Function.pdf}
}

@online{tamimCategoricalInvariantsLearning2025,
  title = {Categorical {{Invariants}} of {{Learning Dynamics}}},
  author = {Tamim, Abdulrahman},
  date = {2025},
  doi = {10.48550/ARXIV.2510.04376},
  url = {https://arxiv.org/abs/2510.04376},
  urldate = {2025-12-28},
  abstract = {Neural network training is typically viewed as gradient descent on a loss surface. We propose a fundamentally different perspective: learning is a structure-preserving transformation (a functor L) between the space of network parameters (Param) and the space of learned representations (Rep). This categorical framework reveals that different training runs producing similar test performance often belong to the same homotopy class (continuous deformation family) of optimization paths. We show experimentally that networks converging via homotopic trajectories generalize within 0.5\% accuracy of each other, while non-homotopic paths differ by over 3\%. The theory provides practical tools: persistent homology identifies stable minima predictive of generalization (R\textasciicircum 2 = 0.82 correlation), pullback constructions formalize transfer learning, and 2-categorical structures explain when different optimization algorithms yield functionally equivalent models. These categorical invariants offer both theoretical insight into why deep learning works and concrete algorithmic principles for training more robust networks.},
  pubstate = {prepublished},
  version = {1},
  keywords = {68T07 18B99 55N35,FOS: Computer and information sciences,I.2.6; F.4.1; G.2.2,Machine Learning (cs.LG)}
}

