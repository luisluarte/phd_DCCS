@article{kimInhibitoryCerebelloOlivaryProjections1998,
  title = {Inhibitory {{Cerebello-Olivary Projections}} and {{Blocking Effect}} in {{Classical Conditioning}}},
  author = {Kim, Jeansok J. and Krupa, David J. and Thompson, Richard F.},
  date = {1998-01-23},
  journaltitle = {Science},
  shortjournal = {Science},
  volume = {279},
  number = {5350},
  pages = {570--573},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.279.5350.570},
  url = {https://www.science.org/doi/10.1126/science.279.5350.570},
  urldate = {2025-11-23},
  abstract = {The behavioral phenomenon of blocking indicates that the informational relationship between the conditioned stimulus and the unconditioned stimulus is essential in classical conditioning. The eyeblink conditioning paradigm is used to describe a neural mechanism that mediates blocking. Disrupting inhibition of the inferior olive, a structure that conveys unconditioned stimulus information (airpuff) to the cerebellum prevented blocking in rabbits. Recordings of cerebellar neuronal activity show that the inferior olive input to the cerebellum becomes suppressed as learning occurs. These results suggest that the inferior olive becomes functionally inhibited by the cerebellum during conditioning, and that this negative feedback process might be the neural mechanism mediating blocking.},
  langid = {english},
  file = {/home/nicoluarte/Zotero/storage/WS9ZNKM8/Kim et al. - 1998 - Inhibitory Cerebello-Olivary Projections and Blocking Effect in Classical Conditioning.pdf}
}

@article{suvrathanTimingRulesSynaptic2016,
  title = {Timing {{Rules}} for {{Synaptic Plasticity Matched}} to {{Behavioral Function}}},
  author = {Suvrathan, Aparna and Payne, Hannah L. and Raymond, Jennifer L.},
  date = {2016-12-07},
  journaltitle = {Neuron},
  shortjournal = {Neuron},
  volume = {92},
  number = {5},
  eprint = {27839999},
  eprinttype = {pubmed},
  pages = {959--967},
  issn = {1097-4199},
  doi = {10.1016/j.neuron.2016.10.022},
  abstract = {It is widely assumed that the complexity of neural circuits enables them to implement diverse learning tasks using just a few generic forms of synaptic plasticity. In contrast, we report that synaptic plasticity can itself be precisely tuned to the requirements of a learning task. We found that the rules for induction of long-term and single-trial plasticity at parallel fiber-to-Purkinje cell synapses vary across cerebellar regions. In the flocculus, associative plasticity in~vitro and in~vivo is narrowly tuned for an interval of ∼120~ms, which compensates for the specific processing delay for error signals to reach the flocculus during oculomotor learning. In the vermis, which supports a range of behavioral functions, plasticity is induced by a range of intervals, with individual cells tuned for different intervals. Thus, plasticity at a single, anatomically defined type of synapse can have properties that vary in a way that is precisely matched to function.},
  langid = {english},
  pmcid = {PMC5165237},
  keywords = {Animals,Cerebellar Vermis,Cerebellum,Eye Movements,Formative Feedback,In Vitro Techniques,Learning,Long-Term Synaptic Depression,Male,Mice,Neuronal Plasticity,Purkinje Cells,Time Factors},
  file = {/home/nicoluarte/Zotero/storage/BVZ22EGY/Suvrathan et al. - 2016 - Timing Rules for Synaptic Plasticity Matched to Behavioral Function.pdf}
}
