cabal-version:      3.0
name:               mycelial
version:            0.1.0.0
license:            MIT
author:             System Architect
maintainer:         architect@mycelial.net
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  MycelialState
                    , MycelialPhysics
                    , MycelialStrategy
                    , MycelialSimulation
                    
                    , Simulation.Types
                    , Simulation.Accessors
                    , Simulation.Evolution
                    , Simulation.Micro
                    , Simulation.Macro
                    , Simulation.Lifecycle
                    , Simulation.Loop

    build-depends:    base >= 4.14 && < 5
                    , random >= 1.2 && < 1.4
                    , mtl >= 2.2 && < 2.4
                    , containers >= 0.6 && < 0.8
                    , text
    hs-source-dirs:   src
    default-language: Haskell2010

executable mycelial-exe
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >= 4.14 && < 5
                    , mycelial
                    , mtl
                    , random
                    , text
    hs-source-dirs:   app
    default-language: Haskell2010

executable mycelial-test
    import:           warnings
    main-is:          MycelialTest.hs
    build-depends:    base >= 4.14 && < 5
                    , mycelial
                    , mtl
    hs-source-dirs:   app
    default-language: Haskell2010