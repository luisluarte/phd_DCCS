# Pure Bull: Linear upward trend (Pt​=Pt−1​+c).
# Pure Bear: Linear downward trend (Pt​=Pt−1​−c).
# Pure Oscillation: Sine wave (Pt​=Asin(wt)+noise).
# Shock/Crash: Stable price followed by a 20% instantaneous drop.
regimes <- function(sim_size) {
bull_series <- (rbeta(n = sim_size, shape1 = 2, shape2 = 1) / 500) - (0.5 / 500)
bear_series <- (rbeta(n = sim_size, shape1 = 1, shape2 = 2) / 500) - (0.5 / 500)
sideways_series <- (rbeta(n = sim_size, shape1 = 2, shape2 = 2) / 500) - (0.5 / 500)
pivot_point <- runif(n = 1, min = sim_size * 0.3, max = sim_size * 0.7)
print(pivot_point)
crash_series <- c(bull_series[1:pivot_point], bear_series[pivot_point + 1:sim_size])
return(crash_series)
}
regimes(365) %>%
cumsum() %>%
plot(., type = "l")
regimes(365) %>%
cumsum() %>%
plot(., type = "l")
regimes(365) %>%
cumsum() %>%
plot(., type = "l")
