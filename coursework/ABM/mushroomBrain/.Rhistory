regimes <- function(sim_size, regime_type, n_sims) {
switch(regime_type,
"bull" = replicate(n = n_sims, bull_series(sim_size)),
"bear" = bear_series(sim_size),
"sideways_series" = sideways_series(sim_size),
"crash_series" = crash_series(sim_size),
stop("invalid choice")
)
}
regimes(252, "bull", 10)
regimes <- function(sim_size, regime_type, n_sims) {
switch(regime_type,
"bull" = replicate(n = n_sims, bull_series(sim_size), simplify = FALSE),
"bear" = bear_series(sim_size),
"sideways_series" = sideways_series(sim_size),
"crash_series" = crash_series(sim_size),
stop("invalid choice")
)
}
regimes(252, "bull", 10)
